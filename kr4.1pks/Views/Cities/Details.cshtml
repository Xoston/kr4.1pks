@model City
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary">&larr; Назад к списку городов</a>
</div>

<div class="row">
    <div class="col-md-4">
        <img src="@Model.PhotoUrl" class="img-fluid rounded mb-3" alt="@Model.Name" />
        <img src="@Model.CoatOfArmsUrl" class="img-fluid rounded mb-3" alt="Герб @Model.Name" />
    </div>
    <div class="col-md-8">
        <h1>@Model.Name</h1>
        <p><strong>Регион:</strong> @Model.Region</p>
        <p><strong>Население:</strong> @Model.Population.ToString("N0") человек</p>
        @if (!string.IsNullOrWhiteSpace(Model.History))
        {
            <h4>История</h4>
            <p>@Model.History</p>
        }
    </div>
</div>

<hr />

<h3>Достопримечательности</h3>
@if (Model.Attractions != null && Model.Attractions.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4 mt-2">
        @foreach (var attraction in Model.Attractions)
        {
            <div class="col">
                <div class="card h-100 attraction-card">
                    <img src="@attraction.PhotoUrl" class="card-img-top" alt="@attraction.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@attraction.Name</h5>
                        <p class="card-text">@attraction.Description</p>
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Attractions" asp-action="Details" asp-route-id="@attraction.Id" class="btn btn-outline-success w-100">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">Для этого города пока нет добавленных достопримечательностей.</div>
}
